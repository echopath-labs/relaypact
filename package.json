{
  "name": "relaypact",
  "version": "0.1.2",
  "description": "Bounded, evidence-driven delegation between AI agents.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "relaypact": "./bin/relaypact.mjs"
  },
  "scripts": {
    "test": "npm run test:contracts && npm run test:core && npm run test:codex-codex && npm run test:codex-pi && npm run test:codex-cursor && npm run test:boundaries",
    "test:contracts": "node --test test/context-contract.test.mjs",
    "test:core": "node --test test/context-planner.test.mjs",
    "test:codex-codex": "node --test test/codex-*.test.mjs",
    "test:codex-pi": "node --test test/run-delegation.test.mjs",
    "test:codex-cursor": "node --test test/cursor-*.test.mjs",
    "test:boundaries": "node --test test/security-boundaries.test.mjs test/package-validation.test.mjs",
    "smoke:pi": "node --test test/integration/pi-smoke.test.mjs",
    "smoke:cursor": "node --test test/integration/cursor-smoke.test.mjs",
    "smoke:codex-plugin": "node --test test/integration/codex-plugin-discovery-smoke.test.mjs",
    "smoke:codex-native": "node --test test/integration/codex-native-smoke.test.mjs",
    "smoke:codex-direct": "node --test test/integration/codex-direct-provider-smoke.test.mjs",
    "smoke:codex-router": "node --test test/integration/codex-router-smoke.test.mjs",
    "validate:architecture": "node scripts/validate-architecture.mjs",
    "validate:package": "node scripts/validate-package.mjs",
    "check:contracts": "npm run test:contracts",
    "check:core": "npm run test:core",
    "check:codex-codex": "npm run test:codex-codex",
    "check:codex-pi": "npm run test:codex-pi",
    "check:codex-cursor": "npm run test:codex-cursor",
    "check:package": "npm run validate:architecture && npm run validate:package && npm run test:boundaries",
    "check": "npm run validate:architecture && npm run validate:package && npm test"
  }
}
